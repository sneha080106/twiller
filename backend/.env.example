# Copy to .env and fill in. Everything except MONGODB_URL is optional:
# anything left blank falls back to a "dev mode" that logs to the console.

PORT=5000

# Required. MongoDB Atlas connection string (or mongodb://127.0.0.1:27017/twiller locally)
MONGODB_URL=

# Frontend URL, used for Stripe success/cancel redirects
CLIENT_URL=http://localhost:3000

# Set to true to disable the time-of-day rules (audio tweets 2-7 PM IST,
# payments 10-11 AM IST, mobile login 10 AM-1 PM IST) so every feature can be
# tried at any hour. Recommended for a public demo.
DEMO_MODE=false

# Firebase Admin service account JSON on ONE line (Firebase Console ->
# Project settings -> Service accounts -> Generate new private key).
# Enables token verification on API routes and real password resets.
# If blank the API runs unauthenticated (dev mode).
FIREBASE_SERVICE_ACCOUNT=

# Email (Gmail app password or other SMTP service). If blank, emails/OTPs are
# printed in the server console and returned as devOtp in API responses.
EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASS=

# Stripe (test mode is fine). If blank, paid plans are applied directly (dev mode).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# SMS provider key. Not wired to a provider yet, so SMS codes are logged to the console.
SMS_API_KEY=
SMS_API_SECRET=
